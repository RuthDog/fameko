{
  "name": "fameko",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:migrate:local": "wrangler d1 migrations apply fameko-pilot --local",
    "dev": "next dev",
    "lint": "eslint app middleware.ts server scripts",
    "opennext:build": "opennextjs-cloudflare build",
    "pilot:provision": "node --experimental-strip-types scripts/provision-pilot-user.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test:auth": "node --experimental-strip-types --test --test-force-exit server/auth/access-token.test.ts server/auth/authorize-request.test.ts server/auth/development-auth.test.ts server/auth/personal-economy-routes.test.ts server/auth/testing/pilot-directory.test.ts server/identity/first-login-provisioning.test.ts server/identity/identity-repository.test.ts",
    "test:planning": "node --experimental-strip-types --test --test-force-exit server/planning/car.test.ts server/planning/development-planning-store.test.ts server/planning/housing.test.ts server/planning/personal-economy.test.ts server/planning/planning-http.test.ts server/planning/planning-repository.test.ts server/planning/savings.test.ts shared/planning/mobile-insights.test.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.119.0"
  }
}
